# /api/fortune が使う環境変数（Vercel の Environment Variables に設定）
# 実ファイルは .env （.gitignore 済み）にコピーして使う。コミットしないこと。

# 使用するLLMプロバイダ: gemini | openai | claude
LLM_PROVIDER=gemini

# 各社APIキー（使うものだけ設定すればよい）
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# モデル上書き（任意。未設定なら下記デフォルト）
#   gemini → gemini-2.5-flash-lite
#   openai → gpt-4.1-nano
#   claude → claude-haiku-4-5
# GEMINI_MODEL=
# OPENAI_MODEL=
# CLAUDE_MODEL=
